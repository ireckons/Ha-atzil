# ─────────────────────────────────────
# Root .env.example – copy to .env and fill in values
# ─────────────────────────────────────

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=haatzil
POSTGRES_USER=haatzil_user
POSTGRES_PASSWORD=change_me_strong_password

# Backend
NODE_ENV=development
PORT=4000
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend (prefix with VITE_ for Vite to expose to browser)
VITE_API_URL=http://localhost:4000

# Admin default credentials (seed only – change immediately in production)
ADMIN_EMAIL=admin@haatzil.co.il
ADMIN_PASSWORD=Admin1234!

# Email (optional – leave blank to skip email confirmation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="האציל <no-reply@haatzil.co.il>"
